+        gpio_set_function(pin, GPIO_FUNC_SIO);
+        gpio_set_pulls(pin, false, false);
+        gpio_put(pin, 1); // SCSI controls are active low.
+        gpio_set_dir(pin, GPIO_OUT);
+        gpio_set_slew_rate(pin, GPIO_SLEW_RATE_FAST);

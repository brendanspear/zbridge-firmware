 // Write one byte to SCSI target using the handshake mechanism
+// Bounded experimental control-byte handshake. Service USB and the watchdog
+// while waiting; a stalled target must not strand the bridge command loop.
+static bool zbridgeWaitForREQ(bool active)
+{
+    if (g_scsiHostPhyReset || (g_zbridgeLegacyProbe.active &&
+        uint32_t(millis() - g_zbridgeProbeCommandStarted) >= 1500)) {
+        g_scsiHostPhyReset = true; SCSI_RELEASE_OUTPUTS(); return false;
+    }
+    const uint32_t started = millis();
+    uint32_t polled = started;
+    while (bool(SCSI_IN(REQ)) != active)
+    {
+        const uint32_t now = millis();
+        if (g_scsiHostPhyReset || uint32_t(now - started) >= 1500 ||
+            (g_zbridgeLegacyProbe.active && uint32_t(now - g_zbridgeProbeCommandStarted) >= 1500))
+        {
+            g_scsiHostPhyReset = true;
+            SCSI_RELEASE_OUTPUTS();
+            return false;
+        }
+        if (uint32_t(now - polled) >= 1)
+        {
+            platform_reset_watchdog(); platform_poll(); polled = now;
+        }
+    }
+    return true;
+}
